# ─────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values
# .env is git-ignored; this file is safe to commit.
# ─────────────────────────────────────────────────────────────────

# Anypoint Platform
ANYPOINT_ORG_ID=your-anypoint-org-id
ANYPOINT_ENV=Sandbox
ANYPOINT_USERNAME=your-username
ANYPOINT_PASSWORD=your-password          # or use ANYPOINT_CLIENT_ID / SECRET

# Flex Gateway ingress (set after CloudHub 2.0 deployment)
INGRESSGW_URL=https://agent-network-ingress-gw-XXXX.kl0dxv.usa-w1.cloudhub.io

# Heroku backend (verification agent + MCP servers)
HEROKU_BACKEND_URL=https://your-backend.herokuapp.com

# Google Gemini
GOOGLE_GEMINI_API_KEY=your-gemini-api-key
GOOGLE_GEMINI_URL=https://generativelanguage.googleapis.com/
GOOGLE_GEMINI_MODEL=gemini-2.5-flash-lite
